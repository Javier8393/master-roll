# ─── Django ───────────────────────────────────────────────
# Generate a new key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-this-with-a-real-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database ─────────────────────────────────────────────
# Never commit the real .env file. Use strong credentials in production.
DB_NAME=your-database-name
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_HOST=db
DB_PORT=5432

# ─── CORS ─────────────────────────────────────────────────
# Frontend origin allowed to make requests to the backend
CORS_ALLOWED_ORIGINS=http://localhost:5173
